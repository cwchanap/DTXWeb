BETTER_AUTH_URL='http://localhost:8787'
BETTER_AUTH_SECRET='my_awesome_better_auth_secret'
DTX_WEB_URL='http://localhost:5173'
AUTH_COOKIE_PREFIX='dtx-local'
GOOGLE_AUTH_CLIENT_ID='my_awesome_google_auth_client_id'
GOOGLE_AUTH_CLIENT_SECRET='my_awesome_google_auth_client_secret'
# AUTH_COOKIE_DOMAIN is intentionally omitted for local development.
PUBLIC_SIMFILE_BUCKET_URL='my_awesome_simfile_bucket_url'
VITE_DTX_API_URL='my_awesome_api_url'
PUBLIC_DTX_API_URL='my_awesome_api_url'

# Desktop Google Drive upload (required for `bun run dev:desktop` and desktop builds)
# Create an OAuth client ID in Google Cloud Console and paste it here.
# The dev script sets DTX_DESKTOP_BUILD_ENV=local / GOOGLE_DRIVE_OAUTH_CLIENT_ENV=local inline;
# only the client ID comes from this file. Build fails without it when the
# google-drive feature is enabled (which is the default).
GOOGLE_DRIVE_OAUTH_CLIENT_ID='my_awesome_google_drive_oauth_client_id'

# Blog download feature flag (disabled by default)
# Set to 'true' to enable download integration on the blog page
PUBLIC_ENABLE_BLOG_DOWNLOAD='false'

# Cloudflare cache purge (optional - for purging CDN cache on file overwrite)
CLOUDFLARE_ZONE_ID='my_awesome_zone_id'
CLOUDFLARE_API_TOKEN='my_awesome_api_token'
