{
	"name": "drumery",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"format": "turbo run //#format:root",
		"check": "turbo run check",
		"dev": "turbo run dtx-web#dev dtx-desktop#dev",
		"dev:web": "npm run dev -w=dtx-web",
		"dev:desktop": "npm run dev -w=dtx-desktop",
		"dev:common": "npm run dev -w=@dtx/common",
		"dev:all": "turbo run dtx-web#dev dtx-desktop#dev @dtx/common#dev",
		"deploy:web": "npm run deploy:prod -w=dtx-web",
		"deploy:web:preprod": "npm run deploy:preprod -w=dtx-web",
		"prepare": "husky || true",
		"clean": "turbo run clean",
		"gen-types": "turbo run gen-types",
		"test:web": "npm run test -w=dtx-web",
		"test:desktop": "npm run test -w=dtx-desktop",
		"test:common": "npm run test -w=@dtx/common",
		"test:coverage:web": "npm run test:coverage -w=dtx-web",
		"test:coverage:desktop": "npm run test:coverage -w=dtx-desktop",
		"test:coverage:common": "npm run test:coverage -w=@dtx/common",
		"format:root": "prettier --write .",
		"fixtures:generate": "npx tsx e2e/fixtures/create-test-midi.ts",
		"fixtures:verify": "npx tsx e2e/fixtures/verify-fixtures.ts",
		"e2e": "npx playwright test",
		"e2e:ui": "npx playwright test --ui"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": "eslint",
		"*.{js,ts,json,md,svelte,css,html}": "prettier --write"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"@types/eslint": "^8.56.0",
		"@types/node": "^20.11.25",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.45.1",
		"eslint-plugin-unused-imports": "^3.2.0",
		"husky": "^9.1.1",
		"lint-staged": "^15.4.3",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.2.6",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"turbo": "^2.5.5"
	},
	"type": "module",
	"packageManager": "npm@10.0.0",
	"workspaces": [
		"packages/dtx-web",
		"packages/dtx-desktop",
		"packages/common",
		"packages/ui-components"
	]
}
