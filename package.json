{
	"name": "drumery",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:web": "turbo run build --filter=dtx-web...",
		"build:api": "turbo run build --filter=dtx-api...",
		"test": "turbo run test",
		"test:coverage": "turbo run test:coverage",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"format": "turbo run //#format:root",
		"check": "turbo run check",
		"dev": "turbo run dtx-api#dev:local dtx-web#dev:local-api dtx-desktop#dev:local-web",
		"dev:web": "bun run --filter=dtx-web dev",
		"dev:desktop": "bun run desktop",
		"desktop": "bun run --filter=dtx-desktop dev",
		"dev:common": "bun run --filter=@dtx/common dev",
		"dev:all": "turbo run dtx-api#dev:local dtx-web#dev:local-api dtx-desktop#dev:local-web @dtx/common#dev",
		"deploy:web": "bun run --filter=dtx-web deploy:prod",
		"deploy:web:preprod": "bun run --filter=dtx-web deploy:preprod",
		"deploy:web:preprod:prod-data": "bun run --filter=dtx-web deploy:preprod:prod-data",
		"deploy:api": "bun run --filter=dtx-api deploy:prod",
		"deploy:api:preprod": "bun run --filter=dtx-api deploy:preprod",
		"deploy:api:preprod:prod-data": "bun run --filter=dtx-api deploy:preprod:prod-data",
		"migrate:api": "bun run --filter=dtx-api migrate:prod",
		"migrate:api:preprod": "bun run --filter=dtx-api migrate:preprod",
		"migrate:api:preprod:prod-data": "bun run --filter=dtx-api migrate:preprod:prod-data",
		"prepare": "husky || true",
		"clean": "turbo run clean",
		"gen:native-types": "bun -e \"const fs=require('node:fs');fs.mkdirSync('packages/dtx-desktop/dist',{recursive:true});const p='packages/dtx-desktop/dist/index.html';if(!fs.existsSync(p))fs.writeFileSync(p,'<!DOCTYPE html><html><head></head><body></body></html>');\" && cross-env DTX_DESKTOP_BUILD_ENV=e2e DTX_E2E_DRUMERY_USER_ID=native-types GOOGLE_DRIVE_OAUTH_CLIENT_ID= GOOGLE_DRIVE_OAUTH_CLIENT_ENV= cargo test --manifest-path packages/dtx-desktop/src-tauri/Cargo.toml --no-default-features --features e2e -- export_",
		"test:web": "bun run --filter=dtx-web test",
		"test:desktop": "bun run --filter=dtx-desktop test",
		"test:common": "bun run --filter=@dtx/common test",
		"test:coverage:web": "bun run --filter=dtx-web test:coverage",
		"test:coverage:desktop": "bun run --filter=dtx-desktop test:coverage",
		"test:coverage:common": "bun run --filter=@dtx/common test:coverage",
		"format:root": "prettier --write .",
		"fixtures:generate": "bun run --filter=dtx-e2e-web fixtures:generate",
		"fixtures:verify": "bun run --filter=dtx-e2e-web fixtures:verify",
		"e2e": "bun run --filter=dtx-e2e-web e2e",
		"e2e:web": "bun run --filter=dtx-e2e-web e2e",
		"e2e:ui": "bun run --filter=dtx-e2e-web e2e:ui",
		"e2e:desktop": "bun run --filter=dtx-e2e-desktop e2e"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": "eslint",
		"*.{js,ts,json,md,svelte,css,html}": "prettier --write"
	},
	"devDependencies": {
		"@types/eslint": "^8.56.0",
		"@types/node": "^20.11.25",
		"@types/uuid": "^10.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.45.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.1",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte-eslint-parser": "^1.8.1",
		"turbo": "^2.10.11"
	},
	"type": "module",
	"packageManager": "bun@1.3.9",
	"engines": {
		"node": ">=22.0.0",
		"bun": ">=1.3.9"
	},
	"workspaces": [
		"packages/dtx-web",
		"packages/dtx-desktop",
		"packages/common",
		"packages/ui-components",
		"packages/dtx-api",
		"packages/e2e-web",
		"packages/e2e-desktop",
		"packages/infrastructure"
	],
	"dependencies": {
		"jszip": "^3.10.1"
	},
	"overrides": {
		"@wdio/native-utils": "^2.5.0"
	}
}
