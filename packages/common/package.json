{
	"name": "@dtx/common",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev --port 5175",
		"build": "vite build && bun run prepack && node scripts/fix-extensions.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "if [ \"$CI\" = \"true\" ]; then svelte-kit sync && svelte-package && publint; else svelte-kit sync && svelte-package; fi",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components.d.ts",
			"svelte": "./dist/components.js",
			"import": "./dist/components.js",
			"default": "./dist/components.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"default": "./dist/server.js"
		},
		"./game": {
			"types": "./dist/game.d.ts",
			"svelte": "./dist/game.js",
			"import": "./dist/game.js",
			"default": "./dist/game.js"
		},
		"./audio": {
			"types": "./dist/audio.d.ts",
			"import": "./dist/audio.js",
			"default": "./dist/audio.js"
		}
	},
	"peerDependencies": {
		"@lucide/svelte": "^0.511.0",
		"@skeletonlabs/skeleton-svelte": "^1.0.0",
		"@supabase/supabase-js": "^2.0.0",
		"dayjs": "^1.11.0",
		"svelte": "^5.0.0",
		"phaser": "^3.88.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250620.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.4.2",
		"@vitest/coverage-v8": "^3.0.0",
		"jsdom": "^25.0.0",
		"publint": "^0.3.22",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"typescript": "^5.0.0",
		"vite": "^6.2.6",
		"vitest": "^3.0.0",
		"tailwindcss": "^4.1.4",
		"@tailwindcss/vite": "^4.3.3",
		"miniflare": "^4.20260721.0"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"drizzle-orm": "^0.45.2",
		"jszip": "^3.10.1",
		"winston": "^3.17.0"
	}
}