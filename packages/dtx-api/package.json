{
	"name": "dtx-api",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./auth-migration": {
			"types": "./src/scripts/migrate-supabase-auth.ts",
			"default": "./src/scripts/migrate-supabase-auth.ts"
		}
	},
	"scripts": {
		"dev": "wrangler dev --var BGM_M4A_GENERATION_ENABLED:false",
		"dev:local": "wrangler dev --local --env-file ../../.env --port 8787 --var AUTH_COOKIE_DOMAIN: --var BGM_M4A_GENERATION_ENABLED:false --var PUBLIC_SIMFILE_BUCKET_URL:http://localhost:8787/local-r2",
		"build": "wrangler deploy --dry-run --env production --outdir=dist --containers-rollout=none --no-x-provision",
		"build:preprod": "wrangler deploy --dry-run --env pre-prod --outdir=dist --containers-rollout=none --no-x-provision",
		"migrate:local": "wrangler d1 migrations apply dtx-web --local --persist-to .wrangler/state",
		"migrate:prod": "wrangler d1 migrations apply dtx-web --remote --env production",
		"migrate:preprod": "wrangler d1 migrations apply dtx-web-preprod --remote --env pre-prod",
		"deploy:prod": "bun run migrate:prod && wrangler deploy --env production --no-x-provision",
		"deploy:preprod": "bun run migrate:preprod && wrangler deploy --env pre-prod --no-x-provision",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"check": "tsc --noEmit",
		"smoke:bgm-transcoder": "bash container/bgm-transcoder/smoke.sh",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"cf-typegen:preprod": "wrangler types --env pre-prod --env-interface CloudflareBindings",
		"gen-schema": "bun run src/scripts/gen-schema.ts",
		"backfill:bgm-m4a": "bun run src/scripts/backfill-bgm-m4a.ts",
		"auth:migrate": "bun run src/scripts/migrate-supabase-auth.ts",
		"auth:schema:generate": "auth generate --config src/auth/auth.cli.ts --output src/auth/schema.ts --adapter drizzle --dialect sqlite --yes",
		"auth:schema:export": "drizzle-kit export --config drizzle.auth.config.ts --sql=true",
		"auth:schema:check": "bun run auth:schema:generate && prettier --write src/auth/schema.ts && git diff --exit-code -- src/auth/schema.ts"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.3.7",
		"@dtx/common": "*",
		"@pothos/core": "^4.13.1",
		"@pothos/plugin-errors": "^4.9.1",
		"@pothos/plugin-scope-auth": "^4.1.7",
		"better-auth": "1.7.2",
		"drizzle-orm": "^0.45.2",
		"graphql": "^16.10.0",
		"graphql-yoga": "^5.22.0",
		"zod": "^4.5.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250620.0",
		"@vitest/coverage-v8": "^3.0.0",
		"auth": "1.7.2",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.8.3",
		"vitest": "^3.1.4",
		"wrangler": "^4.127.1"
	}
}
