{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dtx-api-local",
	"main": "src/index.ts",
	"alias": {
		"@dtx/common/server": "../common/src/lib/server.ts"
	},
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"r2_buckets": [
		{
			"binding": "DTXFILE_BUCKET",
			"bucket_name": "simfile-dtx"
		}
	],
	"kv_namespaces": [
		{
			"binding": "RATE_LIMIT_API"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dtx-web",
			"migrations_dir": "d1-migrations"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "http://localhost:8787",
		"DTX_WEB_URL": "http://localhost:5173",
		"AUTH_COOKIE_PREFIX": "dtx-local",
		"RATE_LIMIT_ENV": "local",
		"GRAPHIQL": "true",
		"CORS_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:8788",
		"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false",
		"PUBLIC_SIMFILE_BUCKET_URL": "https://pub-69ca40bf7a284843b562ff39a68b2e6e.r2.dev",
		"BGM_M4A_GENERATION_ENABLED": "false"
	},
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"dev": {
		"enable_containers": false
	},
	"workflows": [
		{
			"name": "dtx-api-bgm-m4a",
			"binding": "BGM_M4A_WORKFLOW",
			"class_name": "GenerateBgmM4aWorkflow"
		}
	],
	"containers": [
		{
			"class_name": "BgmTranscoderContainer",
			"image": "./container/bgm-transcoder/Dockerfile",
			"instance_type": "basic",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "BGM_TRANSCODER",
				"class_name": "BgmTranscoderContainer"
			}
		]
	},
	"migrations": [
		{
			"tag": "bgm-transcoder-v1",
			"new_sqlite_classes": ["BgmTranscoderContainer"]
		}
	],
	"env": {
		"production": {
			"name": "dtx-api",
			"workers_dev": false,
			"r2_buckets": [
				{
					"binding": "DTXFILE_BUCKET",
					"bucket_name": "simfile-dtx"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_API",
					"id": "b5ff0ae92972479a9e607818f05e15f8"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "dtx-web",
					"database_id": "19376000-d389-4e0e-a5a8-00d9e31a9ffb",
					"migrations_dir": "d1-migrations"
				}
			],
			"vars": {
				"BETTER_AUTH_URL": "https://api.dtx.hapadona.com",
				"DTX_WEB_URL": "https://dtx.hapadona.com",
				"GOOGLE_AUTH_CLIENT_ID": "333977657035-u0r7jj85dv1fv9rqi32e7nl6qb2bn77i.apps.googleusercontent.com",
				"AUTH_COOKIE_DOMAIN": "dtx.hapadona.com",
				"AUTH_COOKIE_PREFIX": "dtx",
				"RATE_LIMIT_ENV": "prod",
				"GRAPHIQL": "false",
				"CORS_ALLOWED_ORIGINS": "https://dtx.hapadona.com",
				"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false",
				"PUBLIC_SIMFILE_BUCKET_URL": "https://chart.hapadona.com",
				"BGM_M4A_GENERATION_ENABLED": "true"
			},
			"workflows": [
				{
					"name": "dtx-api-bgm-m4a",
					"binding": "BGM_M4A_WORKFLOW",
					"class_name": "GenerateBgmM4aWorkflow"
				}
			],
			"containers": [
				{
					"class_name": "BgmTranscoderContainer",
					"image": "./container/bgm-transcoder/Dockerfile",
					"instance_type": "basic",
					"max_instances": 1
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "BGM_TRANSCODER",
						"class_name": "BgmTranscoderContainer"
					}
				]
			},
			"migrations": [
				{
					"tag": "bgm-transcoder-v1",
					"new_sqlite_classes": ["BgmTranscoderContainer"]
				}
			]
		},
		"pre-prod": {
			"name": "dtx-api-pre-prod",
			"workers_dev": false,
			"r2_buckets": [
				{
					"binding": "DTXFILE_BUCKET",
					"bucket_name": "simfile-dtx-preprod"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_API",
					"id": "449636182e7440e48a4361ed19822f6e"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "dtx-web-preprod",
					"database_id": "6fedd126-9dcf-419f-bc2e-eaf8c23d9510",
					"migrations_dir": "d1-migrations"
				}
			],
			"vars": {
				"BETTER_AUTH_URL": "https://api.pre-prod.dtx.hapadona.com",
				"DTX_WEB_URL": "https://pre-prod.dtx.hapadona.com",
				"GOOGLE_AUTH_CLIENT_ID": "333977657035-u0r7jj85dv1fv9rqi32e7nl6qb2bn77i.apps.googleusercontent.com",
				"AUTH_COOKIE_DOMAIN": "pre-prod.dtx.hapadona.com",
				"AUTH_COOKIE_PREFIX": "dtx-preprod",
				"RATE_LIMIT_ENV": "pre-prod",
				"GRAPHIQL": "true",
				"CORS_ALLOWED_ORIGINS": "https://pre-prod.dtx.hapadona.com,http://localhost:5173,http://localhost:8788",
				"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false",
				"PUBLIC_SIMFILE_BUCKET_URL": "https://pub-69ca40bf7a284843b562ff39a68b2e6e.r2.dev",
				"BGM_M4A_GENERATION_ENABLED": "true"
			},
			"workflows": [
				{
					"name": "dtx-api-bgm-m4a-preprod",
					"binding": "BGM_M4A_WORKFLOW",
					"class_name": "GenerateBgmM4aWorkflow"
				}
			],
			"containers": [
				{
					"class_name": "BgmTranscoderContainer",
					"image": "./container/bgm-transcoder/Dockerfile",
					"instance_type": "basic",
					"max_instances": 1
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "BGM_TRANSCODER",
						"class_name": "BgmTranscoderContainer"
					}
				]
			},
			"migrations": [
				{
					"tag": "bgm-transcoder-v1",
					"new_sqlite_classes": ["BgmTranscoderContainer"]
				}
			]
		}
	}
}
