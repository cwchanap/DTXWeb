		"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false",
		"PUBLIC_SIMFILE_BUCKET_URL": "https://pub-771b4400b6c14fa8995fea39c3eff077.r2.dev"
	},
	"keep_vars": true,
