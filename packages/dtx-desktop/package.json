{
	"name": "dtx-desktop",
	"version": "1.0.0",
	"description": "Drumery desktop app",
	"author": "Hapadona",
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.web.json",
		"svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
		"dev": "DTX_DESKTOP_BUILD_ENV=local GOOGLE_DRIVE_OAUTH_CLIENT_ENV=local DTX_DESKTOP_AUTH_CALLBACK_PORT=47931 VITE_DTX_DESKTOP_AUTH_CALLBACK_PORT=47931 bun --env-file ../../.env tauri dev --config src-tauri/tauri.dev.conf.json",
		"dev:local-web": "DTX_DESKTOP_BUILD_ENV=local GOOGLE_DRIVE_OAUTH_CLIENT_ENV=local VITE_DTX_SERVER_URL=http://localhost:5173 VITE_DTX_API_URL=http://localhost:8787 DTX_DESKTOP_AUTH_CALLBACK_PORT=47931 VITE_DTX_DESKTOP_AUTH_CALLBACK_PORT=47931 bun --env-file ../../.env tauri dev --config src-tauri/tauri.dev.conf.json",
		"dev:renderer": "vite --config vite.config.ts",
		"build": "bun run typecheck && tauri build",
		"build:renderer": "vite build --config vite.config.ts",
		"build:debug": "bun run typecheck && tauri build --debug",
		"build:mac": "bun run build",
		"build:win": "bun run build",
		"tauri": "tauri",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage"
	},
	"dependencies": {
		"@dtx/common": "*",
		"@dtx/ui-components": "*",
		"@fontsource/chakra-petch": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/martian-mono": "^5.3.0",
		"@fontsource/sora": "^5.3.0",
		"@lucide/svelte": "^1.33.0",
		"@supabase/supabase-js": "^2.112.3",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-updater": "^2",
		"dayjs": "^1.11.23",
		"phaser": "^3.88.0",
		"svelte-i18n": "^4.0.1",
		"xa_decoder": "^0.1.2"
	},
	"type": "module",
	"devDependencies": {
		"@skeletonlabs/skeleton": "^3.1.2",
		"@skeletonlabs/skeleton-svelte": "^1.2.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@wdio/tauri-plugin": "^1.3.0",
		"@vitest/coverage-v8": "^3.0.0",
		"jsdom": "^26.1.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.2",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^3.1.4"
	}
}
