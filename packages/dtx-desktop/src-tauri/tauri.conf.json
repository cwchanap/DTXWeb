{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Drumery",
	"identifier": "com.hapadona.drumery",
	"build": {
		"beforeDevCommand": "bun run dev:renderer",
		"beforeBuildCommand": "bun run build:renderer",
		"devUrl": "http://localhost:5174",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Drumery",
				"width": 900,
				"height": 670,
				"resizable": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' data: blob:",
				"media-src": "'self' blob:",
				"font-src": "'self' data:",
				"connect-src": "'self' ipc: http://ipc.localhost",
				"frame-src": "'none'",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'self'"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["dmg", "nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"createUpdaterArtifacts": false,
		"resources": ["../static/skin"],
		"macOS": {
			"minimumSystemVersion": "10.13",
			"entitlements": "../build/entitlements.mac.plist"
		},
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper"
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["dtx"]
			}
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExM0Y0NEE4ODE4REM4MzAKUldRd3lJMkJxRVEvb1EyYkkwSlQ5RDJFSC9kbjkrRWdnVXh6RVROYXExcUVlb1BkZytMZDBUZjQK",
			"endpoints": ["https://desktop.hapadona.com/latest.json"]
		}
	}
}
