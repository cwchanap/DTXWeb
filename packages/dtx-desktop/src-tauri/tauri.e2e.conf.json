{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Drumery (E2E)",
	"identifier": "com.hapadona.drumery.e2e",
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Drumery (E2E)",
				"width": 1200,
				"height": 800,
				"minWidth": 640,
				"minHeight": 560,
				"resizable": true
			}
		],
		"security": {
			"capabilities": [
				"main-capability",
				{
					"identifier": "e2e-wdio",
					"description": "WebdriverIO permissions for desktop integration tests",
					"windows": ["main"],
					"permissions": ["wdio:default", "wdio-webdriver:default"]
				}
			]
		}
	},
	"bundle": {
		"active": false
	}
}
