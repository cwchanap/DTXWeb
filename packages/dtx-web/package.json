{
	"name": "dtx-web",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"wrangler:dev": "wrangler dev",
		"deploy": "bun run deploy:prod",
		"deploy:prod": "bun run build && wrangler deploy",
		"deploy:preprod": "bun run build && wrangler deploy --env pre-prod",
		"deploy:preprod:prod-data": "bun run build && wrangler deploy --env pre-prod-prod-data",
		"deploy:preview": "bun run build && wrangler deploy --env preview",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250620.0",
		"@iconify/svelte": "^4.2.0",
		"@lucide/svelte": "^0.511.0",
		"@skeletonlabs/skeleton": "^3.1.2",
		"@skeletonlabs/skeleton-svelte": "^1.2.3",
		"@sveltejs/adapter-cloudflare": "^7.0.4",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.4",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"@vitest/coverage-v8": "^3.0.0",
		"jsdom": "^26.1.0",
		"svelte": "^5.28.1",
		"svelte-check": "^4.1.6",
		"tailwindcss": "^4.1.4",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vite": "^6.3.2",
		"vite-plugin-wasm": "^3.4.1",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^3.1.4"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.787.0",
		"@dtx/common": "*",
		"@dtx/ui-components": "*",
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "^2.49.4",
		"dayjs": "^1.11.13",
		"drizzle-orm": "^0.44.5",
		"jszip": "^3.10.1",
		"phaser": "^3.88.2",
		"svelte-i18n": "^4.0.1",
		"uuid": "^11.1.0",
		"winston": "^3.17.0",
		"xa_decoder": "^0.1.2",
		"zod": "^3.25.67"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.41.0",
		"lightningcss-linux-x64-gnu": "^1.30.1"
	}
}
