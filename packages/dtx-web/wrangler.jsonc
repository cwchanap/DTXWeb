{
	"name": "dtx-web-local",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"vars": {
		"PUBLIC_DTX_API_URL": "http://localhost:8787",
		"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false"
	},
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"env": {
		"production": {
			"name": "dtx-web",
			"route": {
				"pattern": "dtx.hapadona.com",
				"custom_domain": true
			},
			"vars": {
				"PUBLIC_DTX_API_URL": "https://api.dtx.hapadona.com",
				"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false"
			},
			"services": [{ "binding": "API", "service": "dtx-api" }]
		},
		"pre-prod": {
			"name": "dtx-web-pre-prod",
			"vars": {
				"PUBLIC_DTX_API_URL": "https://api.pre-prod.dtx.hapadona.com",
				"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false"
			},
			"services": [{ "binding": "API", "service": "dtx-api-pre-prod" }]
		},
		"pre-prod-prod-data": {
			"name": "dtx-web-pre-prod-prod-data",
			"route": {
				"pattern": "pre-prod.dtx.hapadona.com",
				"custom_domain": true
			},
			"vars": {
				"PUBLIC_DTX_API_URL": "https://api.pre-prod.dtx.hapadona.com",
				"PUBLIC_ENABLE_BLOG_DOWNLOAD": "false"
			},
			"services": [{ "binding": "API", "service": "dtx-api-pre-prod-prod-data" }]
		}
	}
}
