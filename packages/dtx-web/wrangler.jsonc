{
	"name": "dtx-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"route": {
		"pattern": "dtx.hapadona.com",
		"custom_domain": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "DTXFILE_BUCKET",
			"bucket_name": "simfile-dtx"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dtx-web",
			"database_id": "19376000-d389-4e0e-a5a8-00d9e31a9ffb",
			"migrations_dir": "d1-migrations"
		}
	],
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"env": {
		"pre-prod": {
			"route": {
				"pattern": "pre-prod.dtx.hapadona.com",
				"custom_domain": true
			},
			"r2_buckets": [
				{
					"binding": "DTXFILE_BUCKET",
					"bucket_name": "simfile-dtx-preprod"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "dtx-web-preprod",
					"database_id": "6fedd126-9dcf-419f-bc2e-eaf8c23d9510",
					"migrations_dir": "d1-migrations"
				}
			]
		}
	}
}
