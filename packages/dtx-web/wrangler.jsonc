{
	"name": "dtx-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"route": "dtx.hapadona.com/*",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"r2_buckets": [
		{
			"binding": "DTXFILE_BUCKET",
			"bucket_name": "simfile-dtx"
		}
	],
	"keep_vars": true,
	"env": {
		"preview": {
			"name": "dtx-web-preview",
			"route": "preview-dtx.hapadona.com/*",
			"main": ".svelte-kit/cloudflare/_worker.js",
			"compatibility_date": "2025-01-01",
			"compatibility_flags": ["nodejs_compat"],
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare"
			},
			"keep_vars": true,
			"observability": {
				"logs": {
					"enabled": true
				}
			},
			"r2_buckets": [
				{
					"binding": "DTXFILE_BUCKET",
					"bucket_name": "simfile-dtx"
				}
			]
		}
	}
}
