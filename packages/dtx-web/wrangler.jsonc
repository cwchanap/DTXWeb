{
	"name": "dtx-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"route": {
		"pattern": "dtx.hapadona.com",
		"custom_domain": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".cloudflare/public"
	},
	"r2_buckets": [
		{
			"binding": "DTXFILE_BUCKET",
			"bucket_name": "simfile-dtx"
		}
	],
	"keep_vars": true,
	"observability": {
		"logs": {
			"enabled": true
		}
	}
}
