{
	"name": "dtx-e2e",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:desktop": "bun run desktop:build && bun run desktop:test",
		"desktop:build": "cross-env VITE_WDIO=true bun run --filter=dtx-desktop tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
		"desktop:test": "wdio run wdio.desktop.conf.ts",
		"fixtures:generate": "bun run fixtures/create-test-midi.ts",
		"fixtures:verify": "bun run fixtures/verify-fixtures.ts",
		"setup:create-user": "bun run setup/create-local-supabase-user.ts",
		"playwright": "playwright"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"@wdio/cli": "^9.30.0",
		"@wdio/globals": "^9.29.1",
		"@wdio/local-runner": "^9.30.0",
		"@wdio/mocha-framework": "^9.30.0",
		"@wdio/spec-reporter": "^9.29.1",
		"@wdio/tauri-service": "^1.2.0",
		"@wdio/types": "^9.29.1",
		"cross-env": "^10.0.0"
	}
}
