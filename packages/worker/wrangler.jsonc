{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worker",
	"compatibility_flags": ["nodejs_compat"],
	"compatibility_date": "2024-09-23",
	"main": "./src/index.ts",
	"assets": {
		"directory": "./dist-server"
	},
	"r2_buckets": [
		{
			"binding": "DTXFILE_BUCKET",
			"bucket_name": "simfile-dtx"
		}
	],
	"observability": {
		"logs": {
			"enabled": true
		}
	}
}
